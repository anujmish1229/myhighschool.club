# Supabase configuration
# Copy this file to .env and fill in values from
# Supabase Dashboard -> Project Settings -> API

# Project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Public anon / publishable key (safe for the browser; access is enforced by RLS)
VITE_SUPABASE_ANON_KEY=
